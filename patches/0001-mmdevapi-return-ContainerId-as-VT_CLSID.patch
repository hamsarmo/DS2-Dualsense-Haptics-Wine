+                    }
+                    if (SUCCEEDED(CLSIDFromString(guidstr, guid)))
+                    {
+                        pv->vt = VT_CLSID;
+                        pv->puuid = guid;
+                        break;
+                    }
+                    CoTaskMemFree(guid);
+                }
+            }
